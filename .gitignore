# Dependencies
node_modules/

# Build output. Vercel and Netlify both run `npm run build`, so dist/ is generated
# on their side; committing it would make every preview deploy ship a stale bundle.
dist/
dist-ssr/

# Vite / Vitest caches and reports
.vite/
coverage/
*.local

# Host CLIs (`npx vercel`, `netlify deploy`) write their project link + temp files here
.vercel/
.netlify/

# Local overrides. The site is fully static and reads no environment variables,
# so anything matching .env is accidental — ignore it rather than risk publishing it.
.env
.env.*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editors and OS metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
